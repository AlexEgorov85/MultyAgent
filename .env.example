# Ключ доступа к LLM (не коммитить .env!)
OPENAI_API_KEY=

# OpenAI-совместимый endpoint
OPENAI_BASE_URL=https://litellm.standard-data.ru/v1

# Модели
LLM_MODEL=gpt-5-mini
JUDGE_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

# Пути
PGDATA_DIR=data/pg
SEED_DIR=data/seed
KNOWLEDGE_DIR=data/knowledge

# Лимиты
MAX_ROWS=200
SQL_TIMEOUT_SEC=5
