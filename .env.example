# Ключ доступа к LLM (не коммитить .env!)
OPENAI_API_KEY=

# NeuralDeep — OpenAI-совместимый провайдер
OPENAI_BASE_URL=https://api.neuraldeep.ru/v1

# Модели
LLM_MODEL=qwen3.6-35b-a3b
JUDGE_MODEL=qwen3.6-35b-a3b
# frida — RU-first embeddings, 1536 измерений (совпадает со схемой vector(1536))
EMBEDDING_MODEL=frida

# Пути
PGDATA_DIR=data/pg
SEED_DIR=data/seed
KNOWLEDGE_DIR=data/knowledge

# Лимиты
MAX_ROWS=200
SQL_TIMEOUT_SEC=5
