# LLM access key (never commit .env!)
OPENAI_API_KEY=

# NeuralDeep: OpenAI-compatible provider
OPENAI_BASE_URL=https://api.neuraldeep.ru/v1

# Models
LLM_MODEL=qwen3.6-35b-a3b-noreason
JUDGE_MODEL=qwen3.6-35b-a3b-noreason
# frida = RU-first embeddings, 1536 dims (matches vector(1536) in schema)
EMBEDDING_MODEL=frida

# Paths
PGDATA_DIR=data/pg
SEED_DIR=data/seed
KNOWLEDGE_DIR=data/knowledge

# Limits
MAX_ROWS=200
SQL_TIMEOUT_SEC=5
