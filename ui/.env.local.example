# UI
# Браузер обращается к LangGraph через прокси самого UI: /api/...
# С относительным адресом интерфейс работает и на localhost, и по публичной ссылке.
NEXT_PUBLIC_LANGGRAPH_API_URL=/api
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=audit_assistant
# Куда прокси пересылает запросы (серверная часть, доступна только локально)
LANGGRAPH_API_URL=http://127.0.0.1:2024
# Optional: password for a public demo link (Basic Auth). Leave empty to disable.
# SHARE_BASIC_AUTH_USER=demo
# SHARE_BASIC_AUTH_PASSWORD=
